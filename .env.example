# auto | mock | ollama | openrouter
HAVEN_MODEL_ADAPTER=auto

OLLAMA_HOST=http://127.0.0.1:11434
# auto = pick the strongest installed chat model that fits this machine
# (file size plus a RAM reserve that scales with this computer).
# Override with a full Ollama name. Run npm run setup to see what fits.
OLLAMA_MODEL=auto
# Optional. A small installed chat model for Voice call only. Leave empty to
# use the same comfortable model with a shorter spoken prompt.
OLLAMA_CALL_MODEL=

# Optional. Free accounts are rate-limited. Many hosted models refuse adult chat.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
